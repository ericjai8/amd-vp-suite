//@version=6
// =====================================================================
// AMD + Volume Profile Suite  [MNQ]   v5: tighter A box (chop only), any session
//
// 1. ACCUMULATION  Checked on EVERY bar: do the most recent bars form a sideways
//                  range? Walking back from the current bar, the range
//                    - starts where the last impulse leg ended (a stretch that
//                      moved hard in one direction)
//                    - stays narrow: height <= K x the median candle
//                    - is choppy: efficiency (net move / path) <= max
//                    - has no trend/arc shape: quadratic-fit R² <= max
//                    - lasts at least the minimum time, both edges tested
//                    - opening bars that stick out of the core (the tail of the
//                      prior move) are trimmed off
//                    - no V or U: the middle third sits mid-box
//                  The median candle is measured over 24 hours, so sweep candles
//                  can't loosen the limits. The last valid range is remembered for
//                  a while, so a break locks THAT range, not a grown one.
//                  A dotted box shows the range while it is forming.
// 2. MANIPULATION  Price trades beyond the range (that locks it in as "A": volume
//                  profile, POC, VAH, VAL), then CLOSES back inside in time.
//                  Too deep, or no reclaim = a real breakout: setup dropped.
// 3. DISTRIBUTION  Close beyond the POC in the reclaim direction ("D").
// 4. POC RETEST    Pullback to the POC: close back on the right side = CONFIRMED
//                  (entry); closes on the wrong side = FAILED; sweep extreme
//                  broken = INVALID.
// Stop   retest candle | higher low / range edge | sweep extreme, min distance.
// Size   contracts = $ risk / (stop points x point value), capped.
// Targets next untaken liquidity; T1 must be >= min R:R. Part at T1, rest at T2,
//        breakeven after T1. Optional flat at 4:55pm ET (prop rule).
// Rules are in minutes, so they mean the same on any timeframe (tuned on 5m).
// NOT BACKTESTED outside TradingView. Every signal is on a closed bar.
// =====================================================================
strategy("AMD + VP Suite [MNQ]", shorttitle = "AMD VP", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1, process_orders_on_close = true, pyramiding = 0,
     margin_long = 0, margin_short = 0,
     max_boxes_count = 500, max_lines_count = 300, max_labels_count = 300, max_bars_back = 2000)

// ---------------------------------------------------------------- inputs
TZ = "America/New_York"

gQ = "Accumulation detection"
maxLookMin = input.int(480, "Longest range to consider (minutes)", minval = 30, group = gQ)
minAccMin  = input.int(60, "Min length (minutes)", minval = 5, group = gQ)
maxHgtK    = input.float(8.0, "Max range height (x median candle)", minval = 2, step = 0.5, group = gQ, tooltip = "Range height divided by the median candle (high-low). Sideways ranges are only a handful of candles tall.")
maxER      = input.float(0.30, "Max efficiency (0 = chop, 1 = straight line)", minval = 0.05, maxval = 1.0, step = 0.05, group = gQ)
maxShape   = input.float(0.40, "Max trend/arc shape (curve fit R²)", minval = 0.05, maxval = 1.0, step = 0.05, group = gQ, tooltip = "Grinds, V's and rounded arcs fit a curve (high). Real ranges are noise around a flat middle (low).")
impMin     = input.int(30, "Impulse leg: minutes", minval = 5, group = gQ, tooltip = "The range starts where the last strong one-way move ended.")
impK       = input.float(4.0, "Impulse size (x median candle)", minval = 1.0, step = 0.5, group = gQ)
impER      = input.float(0.5, "Impulse straightness (efficiency)", minval = 0.1, maxval = 1.0, step = 0.05, group = gQ)
minTouches = input.int(2, "Min tests of each edge", minval = 1, maxval = 6, group = gQ)
touchPct   = input.float(20, "Edge zone (% of range)", minval = 5, maxval = 40, group = gQ)
trimTol    = input.float(0.15, "Lead-in trim tolerance (% of core height / 100)", minval = 0.0, maxval = 1.0, step = 0.05, group = gQ, tooltip = "Opening bars that poke this far outside the range's core (its last 2/3) are dropped: that's the tail of the move before the chop.")
midBand    = input.float(0.25, "V/U check: middle third must sit between", minval = 0.0, maxval = 0.45, step = 0.05, group = gQ, tooltip = "Average close of the middle third must be between this fraction and 1 minus it of the box height. Rejects V and U shapes.")
staleMin   = input.int(60, "Remember last valid range (minutes)", minval = 0, group = gQ, tooltip = "If price breaks a range that was valid within this time, that range is locked as A.")
showForming = input.bool(true, "Show the range while it forms (dotted)", group = gQ)

gV = "Volume profile"
rows     = input.int(40, "Rows", minval = 10, maxval = 100, group = gV)
vaPct    = input.float(70, "Value area %", minval = 50, maxval = 95, group = gV)
showVP   = input.bool(true, "Draw profile", group = gV)
vpWidth  = input.int(15, "Profile width (bars)", minval = 5, maxval = 150, group = gV)
colUp    = input.color(color.new(#2962ff, 20), "Buy volume", group = gV)
colDn    = input.color(color.new(#ff9800, 20), "Sell volume", group = gV)

gA = "AMD rules"
sweepTicks  = input.int(2, "Sweep: min ticks beyond range", minval = 1, group = gA)
maxDepthPct = input.float(75, "Sweep: max depth (% of range height)", minval = 10, maxval = 300, group = gA, tooltip = "Deeper than this = a real breakout, not a grab.")
reclaimMin  = input.int(30, "Reclaim within (minutes)", minval = 1, group = gA)
retestTicks = input.int(8, "POC retest tolerance (ticks)", minval = 0, group = gA)
retestMin   = input.int(180, "Retest must come within (minutes)", minval = 5, group = gA)
failCloses  = input.int(2, "Failed retest = closes beyond POC", minval = 1, maxval = 5, group = gA)

gR = "Stop, size & targets"
stopMode   = input.string("Higher low / range edge", "Stop placement", options = ["Retest candle", "Higher low / range edge", "Sweep extreme (LL / HH)"], group = gR)
stopTicks  = input.int(4, "Stop buffer (ticks)", minval = 0, group = gR)
minStopATR = input.float(0.5, "Min stop distance (x ATR)", minval = 0.0, step = 0.1, group = gR)
riskUSD    = input.float(300, "Risk per trade ($)", minval = 10, group = gR)
maxQty     = input.int(6, "Max contracts", minval = 1, group = gR)
t1Pct      = input.float(50, "% of position at T1", minval = 0, maxval = 100, group = gR)
minRR      = input.float(1.5, "Min R:R to T1", minval = 0.5, step = 0.25, group = gR)
beAfterT1  = input.bool(true, "Stop to breakeven after T1", group = gR)
tradeLong  = input.bool(true, "Take longs", group = gR)
tradeShort = input.bool(true, "Take shorts", group = gR)
useFlat    = input.bool(true, "Flat by 4:55pm ET, no entries after 4:25pm (prop rule)", group = gR)

gL = "Liquidity"
pivLen     = input.int(5, "Swing strength", minval = 2, maxval = 20, group = gL)
maxLiq     = input.int(10, "Max untaken swings per side", minval = 2, maxval = 30, group = gL)
showLiq    = input.bool(true, "Draw liquidity lines", group = gL)
showPD     = input.bool(true, "PDH / PDL", group = gL)
colBSL     = input.color(color.new(color.lime, 30), "Buy-side liquidity (above highs)", group = gL)
colSSL     = input.color(color.new(color.red, 30), "Sell-side liquidity (below lows)", group = gL)

gD = "Display"
showLevels = input.bool(true, "POC / VAH / VAL lines", group = gD)
showDash   = input.bool(true, "Dashboard", group = gD)

// ---------------------------------------------------------------- basics
tfSec = timeframe.in_seconds()
toBars(int mins, int floorBars) =>
    math.max(floorBars, int(math.ceil(mins * 60.0 / tfSec)))
maxLook     = math.min(toBars(maxLookMin, 10), 400)
minAccBars  = toBars(minAccMin, 4)
impBars     = toBars(impMin, 2)
reclaimBars = toBars(reclaimMin, 1)
retestBars  = toBars(retestMin, 2)
medLen      = math.min(toBars(1440, 20), 1500)   // 24h of candles
staleBars   = toBars(staleMin, 0)

tick  = syminfo.mintick
atr   = ta.atr(14)
hmNow = hour(time, TZ) * 100 + minute(time, TZ)
noEntryTime = useFlat and hmNow >= 1625 and hmNow < 1800

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)

medC    = ta.percentile_nearest_rank(high - low, medLen, 50)          // typical candle
impNet  = math.abs(close - close[impBars])
impPath = math.sum(math.abs(close - close[1]), impBars)

// ---------------------------------------------------------------- continuous range detection
// Longest valid sideways range ENDING AT THIS BAR. Outputs: rLen (0 = none), rHi, rLo.
int   rLen = 0
float rHi  = na
float rLo  = na
if bar_index > maxLook + impBars + 2 and medC > 0
    float hh = high
    float ll = low
    float path = 0.0
    float S0 = 1.0
    float S1 = 0.0
    float S2 = 0.0
    float S3 = 0.0
    float S4 = 0.0
    float Sy = 0.0
    float Sxy = 0.0
    float Sx2y = 0.0
    float Syy = 0.0
    for j = 1 to maxLook
        // the range starts where the last impulse leg ended
        if impPath[j] > 0 and impNet[j] >= impK * medC and impNet[j] / impPath[j] >= impER
            break
        nh = math.max(hh, high[j])
        nl = math.min(ll, low[j])
        if (nh - nl) / medC > maxHgtK
            break
        hh := nh
        ll := nl
        path += math.abs(close[j - 1] - close[j])
        x = float(j)
        y = close[j] - close
        S0 += 1
        S1 += x
        S2 += x * x
        S3 += x * x * x
        S4 += x * x * x * x
        Sy += y
        Sxy += x * y
        Sx2y += x * x * y
        Syy += y * y
        len = j + 1
        if len >= minAccBars
            er = path > 0 ? math.abs(close - close[j]) / path : 1.0
            if er <= maxER
                det = S4 * (S2 * S0 - S1 * S1) - S3 * (S3 * S0 - S1 * S2) + S2 * (S3 * S1 - S2 * S2)
                if math.abs(det) > 1e-9
                    qa = (Sx2y * (S2 * S0 - S1 * S1) - S3 * (Sxy * S0 - S1 * Sy) + S2 * (Sxy * S1 - S2 * Sy)) / det
                    qb = (S4 * (Sxy * S0 - S1 * Sy) - Sx2y * (S3 * S0 - S1 * S2) + S2 * (S3 * Sy - Sxy * S2)) / det
                    qc = (S4 * (S2 * Sy - Sxy * S1) - S3 * (S3 * Sy - Sxy * S2) + Sx2y * (S3 * S1 - S2 * S2)) / det
                    ssTot = Syy - Sy * Sy / S0
                    ssRes = Syy - (qa * Sx2y + qb * Sxy + qc * Sy)
                    r2 = ssTot > 0 ? 1 - ssRes / ssTot : 0.0
                    if r2 <= maxShape
                        rLen := len
    // lead-in trim: drop opening bars that stick out of the core (last 2/3)
    if rLen > 0
        cOff = int(2 * rLen / 3)
        float cH = high
        float cL = low
        for k = 0 to cOff
            cH := math.max(cH, high[k])
            cL := math.min(cL, low[k])
        tol = trimTol * (cH - cL)
        int sOff = rLen - 1
        while sOff > cOff and (high[sOff] > cH + tol or low[sOff] < cL - tol)
            sOff -= 1
        if sOff + 1 >= minAccBars
            rLen := sOff + 1
            float th = high
            float tl = low
            for k = 0 to sOff
                th := math.max(th, high[k])
                tl := math.min(tl, low[k])
            rHi := th
            rLo := tl
        else
            rLen := 0

// edge tests of a range covering bars [off, off + len - 1] bars back
edgeTests(int off, int len, float hi, float lo) =>
    zone = (hi - lo) * touchPct / 100
    int tH = 0
    int tL = 0
    bool inH = false
    bool inL = false
    for k = off + len - 1 to off
        nowH = high[k] >= hi - zone
        nowL = low[k] <= lo + zone
        if nowH and not inH
            tH += 1
        if nowL and not inL
            tL += 1
        inH := nowH
        inL := nowL
    [tH, tL]

// V / U check: where the middle third's average close sits in the box (0 = low, 1 = high)
midPos(int off, int len, float hi, float lo) =>
    i0 = int(len / 3)
    i1 = int(2 * len / 3)
    float sum = 0.0
    int n = 0
    for i = i0 to i1
        sum += close[off + len - 1 - i]
        n += 1
    hi > lo and n > 0 ? (sum / n - lo) / (hi - lo) : 0.5

// ---------------------------------------------------------------- state
var float aHi = na
var float aLo = na
var float poc = na
var float vah = na
var float val = na
var array<box> vpBoxes = array.new<box>()
var line lPOC = na
var line lVAH = na
var line lVAL = na
var box formBox = na
var int   lastLen = 0      // last valid range: length, high, low, bar it ended on
var float lastHi  = na
var float lastLo  = na
var int   lastEnd = na
// 0 scanning, 2 swept (wait reclaim), 3 manipulation (wait POC), 4 beyond POC (wait retest),
// 5 traded / done, 6 failed, 7 invalid / breakout
var int   st       = 0
var int   dir      = 0
var float sweepExt = na
var int   sweepBar = na
var int   pocBar   = na
var int   failCnt  = 0
var int   doneBar  = 0
var string stTxt   = "scanning for accumulation"

amdLbl(string txt, color col, bool atHigh) =>
    label.new(bar_index, atHigh ? high : low, txt, style = atHigh ? label.style_label_down : label.style_label_up,
         color = col, textcolor = color.white, size = size.small)

// lock in the range covering bars [off, off + len - 1] back: profile, levels, box
lockRange(int off, int len) =>
    float hi = high[off]
    float lo = low[off]
    for k = off to off + len - 1
        hi := math.max(hi, high[k])
        lo := math.min(lo, low[k])
    float step = (hi - lo) / rows
    up = array.new<float>(rows, 0.0)
    dn = array.new<float>(rows, 0.0)
    for k = off to off + len - 1
        r0 = math.max(0, math.min(rows - 1, int(math.floor((low[k] - lo) / step))))
        r1 = math.max(0, math.min(rows - 1, int(math.floor((high[k] - lo) / step))))
        share = volume[k] / (r1 - r0 + 1)
        for r = r0 to r1
            if close[k] >= open[k]
                array.set(up, r, array.get(up, r) + share)
            else
                array.set(dn, r, array.get(dn, r) + share)
    tot = array.new<float>(rows, 0.0)
    for r = 0 to rows - 1
        array.set(tot, r, array.get(up, r) + array.get(dn, r))
    pr = array.indexof(tot, array.max(tot))
    target = array.sum(tot) * vaPct / 100
    int vlo = pr
    int vhi = pr
    float acc = array.get(tot, pr)
    while acc < target and (vlo > 0 or vhi < rows - 1)
        nxtUp = vhi < rows - 1 ? array.get(tot, vhi + 1) : -1.0
        nxtDn = vlo > 0 ? array.get(tot, vlo - 1) : -1.0
        if nxtUp >= nxtDn
            vhi += 1
            acc += nxtUp
        else
            vlo -= 1
            acc += nxtDn
    b0 = bar_index - off - len + 1
    if showVP
        while array.size(vpBoxes) > rows * 6
            box.delete(array.shift(vpBoxes))
        mx = array.max(tot)
        for r = 0 to rows - 1
            wTot = int(math.round(vpWidth * array.get(tot, r) / mx))
            wUp = int(math.round(vpWidth * array.get(up, r) / mx))
            y1 = lo + r * step
            y2 = y1 + step
            if wUp > 0
                array.push(vpBoxes, box.new(b0, y2, b0 + wUp, y1, border_color = na, bgcolor = colUp))
            if wTot - wUp > 0
                array.push(vpBoxes, box.new(b0 + wUp, y2, b0 + wTot, y1, border_color = na, bgcolor = colDn))
    box.new(b0, hi, bar_index - off, lo, border_color = color.new(color.gray, 40), bgcolor = color.new(color.gray, 92),
         text = "A", text_color = color.gray, text_size = size.normal, text_halign = text.align_right, text_valign = text.align_top)
    [hi, lo, lo + (pr + 0.5) * step, lo + (vhi + 1) * step, lo + vlo * step, b0]

// ---------------------------------------------------------------- liquidity (untaken swings)
var array<float> bslP = array.new<float>()
var array<line>  bslL = array.new<line>()
var array<float> sslP = array.new<float>()
var array<line>  sslL = array.new<line>()
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    array.push(bslP, ph)
    array.push(bslL, showLiq ? line.new(bar_index - pivLen, ph, bar_index, ph, color = colBSL, style = line.style_dashed, extend = extend.right) : na)
    if array.size(bslP) > maxLiq
        array.shift(bslP)
        line.delete(array.shift(bslL))
if not na(pl)
    array.push(sslP, pl)
    array.push(sslL, showLiq ? line.new(bar_index - pivLen, pl, bar_index, pl, color = colSSL, style = line.style_dashed, extend = extend.right) : na)
    if array.size(sslP) > maxLiq
        array.shift(sslP)
        line.delete(array.shift(sslL))
if array.size(bslP) > 0
    for i = array.size(bslP) - 1 to 0
        if high > array.get(bslP, i)
            ln = array.get(bslL, i)
            if not na(ln)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                line.set_style(ln, line.style_dotted)
            array.remove(bslP, i)
            array.remove(bslL, i)
if array.size(sslP) > 0
    for i = array.size(sslP) - 1 to 0
        if low < array.get(sslP, i)
            ln = array.get(sslL, i)
            if not na(ln)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                line.set_style(ln, line.style_dotted)
            array.remove(sslP, i)
            array.remove(sslL, i)

nextLiq(float from, int d, float minDist) =>
    float best = na
    cands = array.new<float>()
    src = d == 1 ? bslP : sslP
    if array.size(src) > 0
        for i = 0 to array.size(src) - 1
            array.push(cands, array.get(src, i))
    array.push(cands, d == 1 ? aHi : aLo)
    array.push(cands, d == 1 ? pdh : pdl)
    for i = 0 to array.size(cands) - 1
        p = array.get(cands, i)
        if not na(p) and (p - from) * d >= minDist
            if na(best) or (p - from) * d < (best - from) * d
                best := p
    best

// ---------------------------------------------------------------- AMD state machine
sigEntry   = false
sigFail    = false
sigInvalid = false
sigManip   = false
sigPOC     = false
float eStop = na
float eT1   = na
float eT2   = na
int   eQty  = 0
pos = strategy.position_size

if barstate.isconfirmed
    // finished setups: back to scanning once flat
    if (st == 5 or st == 6 or st == 7) and pos == 0 and bar_index > doneBar
        st := 0
        stTxt := "scanning for accumulation"
    // remember the most recent valid range
    if st == 0 and rLen[1] >= minAccBars
        lastLen := rLen[1]
        lastHi := rHi[1]
        lastLo := rLo[1]
        lastEnd := bar_index - 1
    // 0 -> 2: price trades beyond the last valid range (if it is recent)
    if st == 0 and lastLen > 0 and bar_index - 1 - lastEnd <= staleBars and not noEntryTime
        breakDn = low <= lastLo - sweepTicks * tick and tradeLong
        breakUp = high >= lastHi + sweepTicks * tick and tradeShort
        if breakDn or breakUp
            off = bar_index - lastEnd
            [tH, tL] = edgeTests(off, lastLen, lastHi, lastLo)
            mp = midPos(off, lastLen, lastHi, lastLo)
            if tH >= minTouches and tL >= minTouches and mp >= midBand and mp <= 1 - midBand
                if not na(lPOC)
                    line.set_extend(lPOC, extend.none)
                    line.set_x2(lPOC, bar_index)
                    line.set_extend(lVAH, extend.none)
                    line.set_x2(lVAH, bar_index)
                    line.set_extend(lVAL, extend.none)
                    line.set_x2(lVAL, bar_index)
                [hi_, lo_, poc_, vah_, val_, b0_] = lockRange(off, lastLen)
                lastLen := 0
                aHi := hi_
                aLo := lo_
                poc := poc_
                vah := vah_
                val := val_
                if showLevels
                    lPOC := line.new(b0_, poc, bar_index, poc, color = color.red, width = 2, extend = extend.right)
                    lVAH := line.new(b0_, vah, bar_index, vah, color = color.new(color.white, 20), extend = extend.right)
                    lVAL := line.new(b0_, val, bar_index, val, color = color.new(color.white, 20), extend = extend.right)
                st := 2
                dir := breakDn ? 1 : -1
                sweepExt := breakDn ? low : high
                sweepBar := bar_index
                failCnt := 0
                stTxt := "accumulation broken: sweep or breakout?"
    if st == 2
        sweepExt := dir == 1 ? math.min(sweepExt, low) : math.max(sweepExt, high)
        depth = dir == 1 ? aLo - sweepExt : sweepExt - aHi
        if depth > maxDepthPct / 100 * (aHi - aLo)
            st := 7
            doneBar := bar_index
            stTxt := "breakout, not a sweep"
        else if (dir == 1 and close > aLo) or (dir == -1 and close < aHi)
            st := 3
            sigManip := true
            stTxt := "manipulation: sweep reclaimed"
            amdLbl("M", color.purple, dir == -1)
        else if bar_index - sweepBar >= reclaimBars
            st := 7
            doneBar := bar_index
            stTxt := "no reclaim: accepted beyond range"
    else if st == 3
        if (dir == 1 and close > poc) or (dir == -1 and close < poc)
            st := 4
            pocBar := bar_index
            failCnt := 0
            sigPOC := true
            stTxt := "distribution: beyond POC, wait for retest"
            amdLbl("D", color.teal, dir == -1)
        else if (dir == 1 and close < sweepExt) or (dir == -1 and close > sweepExt)
            st := 7
            doneBar := bar_index
            sigInvalid := true
            stTxt := "INVALID: sweep extreme broken"
    else if st == 4 and bar_index > pocBar
        touched = dir == 1 ? low <= poc + retestTicks * tick : high >= poc - retestTicks * tick
        rightSide = dir == 1 ? close > poc : close < poc
        if not rightSide
            failCnt += 1
            if failCnt >= failCloses
                st := 6
                doneBar := bar_index
                sigFail := true
                stTxt := "POC retest FAILED"
                amdLbl("✗ POC", color.red, dir == 1)
        else
            failCnt := 0
            if touched and not noEntryTime
                entry = close
                float base = na
                if stopMode == "Retest candle"
                    base := dir == 1 ? math.min(low, poc) : math.max(high, poc)
                else if stopMode == "Higher low / range edge"
                    base := dir == 1 ? math.min(val, aLo, low) : math.max(vah, aHi, high)
                else
                    base := sweepExt
                stp = base - dir * stopTicks * tick
                if math.abs(entry - stp) < minStopATR * atr
                    stp := entry - dir * minStopATR * atr
                risk = math.abs(entry - stp)
                qty = risk > 0 ? math.min(maxQty, int(math.floor(riskUSD / (risk * syminfo.pointvalue)))) : 0
                t1 = nextLiq(entry, dir, minRR * risk)
                t2 = na(t1) ? na : nextLiq(t1, dir, tick)
                st := 5
                doneBar := bar_index
                if qty < 1
                    stTxt := "retest held, stop too wide for $" + str.tostring(riskUSD) + ": skipped"
                    amdLbl("✓ skip $", color.gray, dir == -1)
                else if na(t1)
                    stTxt := "retest held, no target >= " + str.tostring(minRR) + "R: skipped"
                    amdLbl("✓ skip R", color.gray, dir == -1)
                else
                    sigEntry := true
                    eStop := stp
                    eT1 := t1
                    eT2 := na(t2) ? t1 + dir * risk : t2
                    eQty := qty
                    stTxt := "POC retest CONFIRMED: entry"
                    amdLbl("✓ POC", color.green, dir == -1)
            else if bar_index - pocBar > retestBars
                st := 5
                doneBar := bar_index
                stTxt := "no retest in time"
    if st == 6 and ((dir == 1 and close < sweepExt) or (dir == -1 and close > sweepExt))
        st := 7
        doneBar := bar_index
        sigInvalid := true
        stTxt := "INVALID: sweep extreme broken"

// range forming (live view)
if showForming and barstate.islast
    box.delete(formBox)
    if st == 0 and rLen >= minAccBars
        formBox := box.new(bar_index - rLen + 1, rHi, bar_index, rLo, border_color = color.new(color.yellow, 30),
             border_style = line.style_dotted, bgcolor = color.new(color.yellow, 95), text = "forming", text_color = color.new(color.yellow, 30),
             text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)

// ---------------------------------------------------------------- orders
var float tStop = na
var float tT1   = na
var float tT2   = na
var float tEnt  = na
var int   tQty  = 0
var bool  t1Done = false
if sigEntry and pos == 0
    tEnt := close
    tStop := eStop
    tT1 := eT1
    tT2 := eT2
    tQty := eQty
    t1Done := false
    strategy.entry(dir == 1 ? "L" : "S", dir == 1 ? strategy.long : strategy.short, qty = eQty, comment = dir == 1 ? "AMD long" : "AMD short")
if pos != 0
    id = pos > 0 ? "L" : "S"
    q1 = tQty == 1 ? 1 : int(math.round(tQty * t1Pct / 100))
    qRest = tQty - q1
    if not t1Done and q1 > 0 and math.abs(pos) < tQty
        t1Done := true
        if beAfterT1
            tStop := tEnt
    if not t1Done and q1 > 0
        strategy.exit("T1", id, qty = q1, limit = tT1, stop = tStop, comment_profit = "T1", comment_loss = "Stop")
    if qRest > 0
        strategy.exit("T2", id, qty = qRest, limit = tT2, stop = tStop, comment_profit = "T2", comment_loss = tStop == tEnt ? "BE" : "Stop")
if useFlat and pos != 0 and hmNow >= 1655 and hmNow < 1800
    strategy.close_all(comment = "Flat 4:55")

// ---------------------------------------------------------------- plots
inPos = pos != 0
plot(inPos ? tStop : na, "Stop", color = color.red, style = plot.style_linebr)
plot(inPos ? tT1 : na, "T1", color = color.lime, style = plot.style_linebr)
plot(inPos ? tT2 : na, "T2", color = color.new(color.lime, 50), style = plot.style_linebr)
plot(inPos ? tEnt : na, "Entry", color = color.gray, style = plot.style_linebr)
plot(showPD ? pdh : na, "PDH", color = colBSL, style = plot.style_stepline)
plot(showPD ? pdl : na, "PDL", color = colSSL, style = plot.style_stepline)

// ---------------------------------------------------------------- dashboard
var table dash = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)
if showDash and barstate.islast
    table.cell(dash, 0, 0, "AMD", text_color = color.white)
    table.cell(dash, 1, 0, st == 0 ? "—" : dir == 1 ? "Bullish" : "Bearish", text_color = st == 0 ? color.gray : dir == 1 ? color.lime : color.red)
    table.cell(dash, 0, 1, "State", text_color = color.white)
    table.cell(dash, 1, 1, st == 0 and rLen >= minAccBars ? "range forming (" + str.tostring(rLen) + " bars)" : stTxt, text_color = color.yellow)
    table.cell(dash, 0, 2, "POC", text_color = color.white)
    table.cell(dash, 1, 2, na(poc) ? "—" : str.tostring(poc, format.mintick), text_color = color.red)
    table.cell(dash, 0, 3, "VAH / VAL", text_color = color.white)
    table.cell(dash, 1, 3, na(poc) ? "—" : str.tostring(vah, format.mintick) + " / " + str.tostring(val, format.mintick), text_color = color.white)
    table.cell(dash, 0, 4, "Range H / L", text_color = color.white)
    table.cell(dash, 1, 4, na(aHi) ? "—" : str.tostring(aHi, format.mintick) + " / " + str.tostring(aLo, format.mintick), text_color = color.gray)
    table.cell(dash, 0, 5, "Sweep", text_color = color.white)
    table.cell(dash, 1, 5, na(sweepExt) ? "—" : str.tostring(sweepExt, format.mintick), text_color = color.purple)
    table.cell(dash, 0, 6, "Trade", text_color = color.white)
    table.cell(dash, 1, 6, inPos ? (str.tostring(tQty) + " @ " + str.tostring(tEnt, format.mintick) + " | stop " + str.tostring(tStop, format.mintick) + " | T1 " + str.tostring(tT1, format.mintick) + " | T2 " + str.tostring(tT2, format.mintick)) : "flat", text_color = color.white)

// ---------------------------------------------------------------- alerts (Discord-ready JSON)
j(string s) => '{"content": "AMD VP | ' + syminfo.ticker + ' | ' + s + '"}'
if sigManip
    alert(j((dir == 1 ? "Bullish" : "Bearish") + " manipulation: sweep to " + str.tostring(sweepExt, format.mintick) + " reclaimed"), alert.freq_once_per_bar_close)
if sigPOC
    alert(j("Distribution: closed beyond POC " + str.tostring(poc, format.mintick) + " - waiting for retest"), alert.freq_once_per_bar_close)
if sigEntry
    alert(j("POC retest CONFIRMED - " + (dir == 1 ? "LONG " : "SHORT ") + str.tostring(eQty) + " @ " + str.tostring(close, format.mintick) + " | stop " + str.tostring(eStop, format.mintick) + " | T1 " + str.tostring(eT1, format.mintick) + " | T2 " + str.tostring(eT2, format.mintick)), alert.freq_once_per_bar_close)
if sigFail
    alert(j("POC retest FAILED at " + str.tostring(poc, format.mintick)), alert.freq_once_per_bar_close)
if sigInvalid
    alert(j("INVALID - sweep extreme " + str.tostring(sweepExt, format.mintick) + " broken"), alert.freq_once_per_bar_close)
