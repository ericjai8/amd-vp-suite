//@version=6
// =====================================================================
// AMD + Volume Profile Suite  [MNQ]   v2
//
// 1. ACCUMULATION  Inside a search window (default Asia, 6pm-2am ET) the script
//                  finds the LATEST TIGHT RANGE before the window ends:
//                    - starts where the last impulse leg ended
//                    - walks back while the candles stay SIDEWAYS: range height
//                      <= K x the median candle, efficiency (net / path) <= max,
//                      and no trend/arc shape (quadratic-fit R² <= max)
//                    - at least M bars long
//                    - both edges tested at least K times (that builds liquidity)
//                  Fails any rule -> "no accumulation", no AMD that day.
//                  Built-in volume profile of that range -> POC, VAH, VAL.
// 2. MANIPULATION  Price sweeps beyond the range and CLOSES back inside within N bars.
// 3. DISTRIBUTION  Price closes beyond the POC in the reclaim direction.
// 4. POC RETEST    Pullback to the POC: close back on the right side -> CONFIRMED,
//                  2 closes on the wrong side -> FAILED, sweep extreme broken -> INVALID.
// Entry  close of the confirmed retest candle.
// Stop   your choice: retest candle | higher low / range edge | sweep extreme (the LL),
//        never closer than a minimum distance (x ATR).
// Size   contracts = dollar risk / (stop distance x point value), capped.
// Targets next untaken liquidity (swings, range edge, PDH/PDL); T1 must be >= min R:R.
// Exits  part at T1, rest at T2, stop to breakeven after T1, flat at 4:55pm ET.
//
// NOT BACKTESTED outside TradingView. Judge it with the Strategy Tester and paper
// trading. Every signal is on a closed bar; nothing repaints.
// =====================================================================
strategy("AMD + VP Suite [MNQ]", shorttitle = "AMD VP", overlay = true,
     initial_capital = 50000, default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
     slippage = 1, process_orders_on_close = true, pyramiding = 0,
     margin_long = 0, margin_short = 0,
     max_boxes_count = 500, max_lines_count = 300, max_labels_count = 300, max_bars_back = 2000)

// ---------------------------------------------------------------- inputs
TZ = "America/New_York"
gS = "Sessions (ET)"
accSess   = input.session("1800-0200", "Accumulation search window", group = gS, tooltip = "Where to look for the accumulation range. Auto-fit finds the latest tight range inside it. For London try 0200-0830; for the NY open range 0930-1030.")
tradeSess = input.session("0200-1655", "Trade window (sweeps, entries)", group = gS)
flatHM    = input.int(1655, "Flat all trades at (HHMM ET)", group = gS)

gQ = "Accumulation detection"
accMode    = input.string("Auto-fit (latest tight range)", "Mode", options = ["Auto-fit (latest tight range)", "Whole window"], group = gQ)
maxHgtK    = input.float(8.0, "Max range height (x median candle)", minval = 2, step = 0.5, group = gQ, tooltip = "Range height divided by the median candle (high-low) inside it. Sideways ranges are only a handful of candles tall; a trend leg is many.")
maxER      = input.float(0.30, "Max efficiency (0 = chop, 1 = straight line)", minval = 0.05, maxval = 1.0, step = 0.05, group = gQ, tooltip = "Net close-to-close move divided by the total distance travelled. Sideways candles go back and forth, so this stays low.")
impBars    = input.int(6, "Stop at an impulse leg: bars", minval = 2, maxval = 30, group = gQ, tooltip = "Accumulation starts where the last strong move ends. Walking back, the box stops if the N bars before a point moved hard in one direction.")
impK       = input.float(4.0, "Impulse size (x median candle)", minval = 1.0, step = 0.5, group = gQ)
impER      = input.float(0.5, "Impulse straightness (efficiency)", minval = 0.1, maxval = 1.0, step = 0.05, group = gQ)
maxShape   = input.float(0.40, "Max trend/arc shape (curve fit R²)", minval = 0.05, maxval = 1.0, step = 0.05, group = gQ, tooltip = "How much of the movement a smooth curve explains. Grinds, V's and rounded arcs fit a curve (high); real ranges are noise around a flat middle (low).")
minAccBars = input.int(12, "Min length (bars)", minval = 3, group = gQ, tooltip = "12 bars = 1 hour on 5m.")
endSlack   = input.int(24, "Range may end up to N bars before the window ends", minval = 0, maxval = 200, group = gQ, tooltip = "Auto-fit tries every end point in the last N bars of the window and keeps the LONGEST tight range. 24 bars = 2 hours on 5m. Stops a late pre-London move from hiding the range.")
minTouches = input.int(2, "Min tests of each edge", minval = 1, maxval = 6, group = gQ, tooltip = "Separate visits to the top and bottom of the range. This is what builds the liquidity a sweep goes after.")
touchPct   = input.float(20, "Edge zone (% of range)", minval = 5, maxval = 40, group = gQ, tooltip = "A bar 'tests' an edge if it trades within this % of the range from the high or low.")

gV = "Volume profile"
rows     = input.int(40, "Rows", minval = 10, maxval = 100, group = gV)
vaPct    = input.float(70, "Value area %", minval = 50, maxval = 95, group = gV)
showVP   = input.bool(true, "Draw profile", group = gV)
vpWidth  = input.int(15, "Profile width (bars)", minval = 5, maxval = 150, group = gV)
colUp    = input.color(color.new(#2962ff, 20), "Buy volume", group = gV)
colDn    = input.color(color.new(#ff9800, 20), "Sell volume", group = gV)

gA = "AMD rules"
sweepTicks  = input.int(2, "Sweep: min ticks beyond range", minval = 1, group = gA)
maxDepthPct = input.float(75, "Sweep: max depth (% of range height)", minval = 10, maxval = 300, group = gA, tooltip = "Deeper than this = a real breakout, not a grab.")
reclaimBars = input.int(6, "Reclaim within (bars)", minval = 1, maxval = 30, group = gA)
retestTicks = input.int(8, "POC retest tolerance (ticks)", minval = 0, group = gA)
retestBars  = input.int(36, "Retest must come within (bars)", minval = 3, group = gA)
failCloses  = input.int(2, "Failed retest = closes beyond POC", minval = 1, maxval = 5, group = gA)

gR = "Stop, size & targets"
stopMode   = input.string("Higher low / range edge", "Stop placement", options = ["Retest candle", "Higher low / range edge", "Sweep extreme (LL / HH)"], group = gR, tooltip = "Retest candle: tightest, easily wicked out. Higher low / range edge: below the lower of VAL and the range low (above for shorts). Sweep extreme: the real invalidation, widest.")
stopTicks  = input.int(4, "Stop buffer (ticks)", minval = 0, group = gR)
minStopATR = input.float(0.5, "Min stop distance (x ATR)", minval = 0.0, step = 0.1, group = gR)
riskUSD    = input.float(300, "Risk per trade ($)", minval = 10, group = gR, tooltip = "Contracts = this / (stop points x point value). A wide stop means fewer contracts, not more risk.")
maxQty     = input.int(6, "Max contracts", minval = 1, group = gR)
t1Pct      = input.float(50, "% of position at T1", minval = 0, maxval = 100, group = gR)
minRR      = input.float(1.5, "Min R:R to T1", minval = 0.5, step = 0.25, group = gR)
beAfterT1  = input.bool(true, "Stop to breakeven after T1", group = gR)
tradeLong  = input.bool(true, "Take longs", group = gR)
tradeShort = input.bool(true, "Take shorts", group = gR)

gL = "Liquidity"
pivLen     = input.int(5, "Swing strength", minval = 2, maxval = 20, group = gL)
maxLiq     = input.int(10, "Max untaken swings per side", minval = 2, maxval = 30, group = gL)
showLiq    = input.bool(true, "Draw liquidity lines", group = gL)
showPD     = input.bool(true, "PDH / PDL", group = gL)
colBSL     = input.color(color.new(color.lime, 30), "Buy-side liquidity (above highs)", group = gL)
colSSL     = input.color(color.new(color.red, 30), "Sell-side liquidity (below lows)", group = gL)

gD = "Display"
showLevels = input.bool(true, "POC / VAH / VAL lines", group = gD)
showDash   = input.bool(true, "Dashboard", group = gD)

// ---------------------------------------------------------------- basics
tick  = syminfo.mintick
atr   = ta.atr(14)
inAcc   = not na(time(timeframe.period, accSess, TZ))
inTrade = not na(time(timeframe.period, tradeSess, TZ))
hmNow   = hour(time, TZ) * 100 + minute(time, TZ)
accStart = inAcc and not inAcc[1]
accEnd   = not inAcc and inAcc[1]

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)

// ---------------------------------------------------------------- search-window data
var array<float> aO  = array.new<float>()
var array<float> aH  = array.new<float>()
var array<float> aL  = array.new<float>()
var array<float> aC  = array.new<float>()
var array<float> aV  = array.new<float>()
var array<bool>  aUp = array.new<bool>()
var array<int>   aB  = array.new<int>()
if accStart
    array.clear(aO)
    array.clear(aH)
    array.clear(aL)
    array.clear(aC)
    array.clear(aV)
    array.clear(aUp)
    array.clear(aB)
if inAcc
    array.push(aO, open)
    array.push(aH, high)
    array.push(aL, low)
    array.push(aC, close)
    array.push(aV, volume)
    array.push(aUp, close >= open)
    array.push(aB, bar_index)

// ---------------------------------------------------------------- profile + state
var float rngH = na
var float rngL = na
var float poc  = na
var float vah  = na
var float val  = na
var int   accBar0 = na
var array<box> vpBoxes = array.new<box>()
var line lPOC = na
var line lVAH = na
var line lVAL = na

// AMD state: 0 idle, 1 watching for sweep, 2 swept (wait reclaim), 3 manipulation confirmed (wait POC),
//            4 beyond POC (wait retest), 5 traded / done, 6 failed, 7 invalid
var int   st       = 0
var int   dir      = 0
var float sweepExt = na
var int   sweepBar = na
var int   pocBar   = na
var int   failCnt  = 0
var string stTxt   = "waiting for the search window"

// end the previous day's lines when a new search window starts
if accStart
    if not na(lPOC)
        line.set_extend(lPOC, extend.none)
        line.set_x2(lPOC, bar_index)
        line.set_extend(lVAH, extend.none)
        line.set_x2(lVAH, bar_index)
        line.set_extend(lVAL, extend.none)
        line.set_x2(lVAL, bar_index)
    st := 0
    dir := 0
    poc := na
    stTxt := "searching for accumulation"

effic(array<float> cs, int a, int b) =>
    float pth = 0.0
    for i = a + 1 to b
        pth += math.abs(array.get(cs, i) - array.get(cs, i - 1))
    pth > 0 ? math.abs(array.get(cs, b) - array.get(cs, a)) / pth : 1.0

if accEnd and array.size(aH) > minAccBars
    n = array.size(aH)
    // ---- 1. find the sideways candles: from each end point in the last `endSlack` bars, walk back
    //         while the span stays narrow (height <= K x median candle). A span qualifies when it is
    //         choppy (efficiency <= max) and has no trend/arc shape (quadratic-fit R² <= max).
    //         Keep the longest qualifying span.
    int s0 = 0
    int e0 = n - 1
    float hi = array.max(aH)
    float lo = array.min(aL)
    if accMode == "Auto-fit (latest tight range)"
        int bestLen = 0
        for e = n - 1 to math.max(1, n - 1 - endSlack)
            float h_ = array.get(aH, e)
            float l_ = array.get(aL, e)
            float path = 0.0
            float ce = array.get(aC, e)
            // running sums for a quadratic fit of close vs. x (x = bars back from e), y centred on ce
            float S0 = 1.0
            float S1 = 0.0
            float S2 = 0.0
            float S3 = 0.0
            float S4 = 0.0
            float Sy = 0.0
            float Sxy = 0.0
            float Sx2y = 0.0
            float Syy = 0.0
            rngs = array.new<float>()
            array.push(rngs, array.get(aH, e) - array.get(aL, e))
            for i = e - 1 to 0
                // stop at the end of the last impulse leg (the impBars bars ending at i moved hard one way)
                if array.size(rngs) >= 6 and i - impBars >= 0
                    med0 = array.median(rngs)
                    float pth = 0.0
                    for k = i - impBars + 1 to i
                        pth += math.abs(array.get(aC, k) - array.get(aC, k - 1))
                    net = math.abs(array.get(aC, i) - array.get(aC, i - impBars))
                    if med0 > 0 and pth > 0 and net >= impK * med0 and net / pth >= impER
                        break
                nh = math.max(h_, array.get(aH, i))
                nl = math.min(l_, array.get(aL, i))
                array.push(rngs, array.get(aH, i) - array.get(aL, i))
                med = array.median(rngs)
                if array.size(rngs) >= 6 and med > 0 and (nh - nl) / med > maxHgtK
                    break
                h_ := nh
                l_ := nl
                path += math.abs(array.get(aC, i + 1) - array.get(aC, i))
                x = float(e - i)
                y = array.get(aC, i) - ce
                S0 += 1
                S1 += x
                S2 += x * x
                S3 += x * x * x
                S4 += x * x * x * x
                Sy += y
                Sxy += x * y
                Sx2y += x * x * y
                Syy += y * y
                spanLen = e - i + 1
                if spanLen > bestLen and spanLen >= minAccBars
                    er = path > 0 ? math.abs(ce - array.get(aC, i)) / path : 1.0
                    if er <= maxER
                        // solve [S4 S3 S2; S3 S2 S1; S2 S1 S0] [a b c] = [Sx2y Sxy Sy] (Cramer)
                        det = S4 * (S2 * S0 - S1 * S1) - S3 * (S3 * S0 - S1 * S2) + S2 * (S3 * S1 - S2 * S2)
                        if math.abs(det) > 1e-9
                            qa = (Sx2y * (S2 * S0 - S1 * S1) - S3 * (Sxy * S0 - S1 * Sy) + S2 * (Sxy * S1 - S2 * Sy)) / det
                            qb = (S4 * (Sxy * S0 - S1 * Sy) - Sx2y * (S3 * S0 - S1 * S2) + S2 * (S3 * Sy - Sxy * S2)) / det
                            qc = (S4 * (S2 * Sy - Sxy * S1) - S3 * (S3 * Sy - Sxy * S2) + Sx2y * (S3 * S1 - S2 * S2)) / det
                            ssTot = Syy - Sy * Sy / S0
                            ssRes = Syy - (qa * Sx2y + qb * Sxy + qc * Sy)
                            r2 = ssTot > 0 ? 1 - ssRes / ssTot : 0.0
                            if r2 <= maxShape
                                bestLen := spanLen
                                s0 := i
                                e0 := e
                                hi := h_
                                lo := l_
        // trim the lead-in: start where closes first sit inside the span's core (15th-85th percentile)
        if bestLen > 0
            core = array.new<float>()
            for i = s0 to e0
                array.push(core, array.get(aC, i))
            q1 = array.percentile_nearest_rank(core, 15)
            q2 = array.percentile_nearest_rank(core, 85)
            while s0 < e0 - minAccBars and (array.get(aC, s0) < q1 or array.get(aC, s0) > q2)
                s0 += 1
            hi := array.get(aH, s0)
            lo := array.get(aL, s0)
            for i = s0 to e0
                hi := math.max(hi, array.get(aH, i))
                lo := math.min(lo, array.get(aL, i))
    len = e0 - s0 + 1
    hgt = hi - lo
    // ---- 2. checks
    string why = ""
    if len < minAccBars
        why := "no sideways stretch of " + str.tostring(minAccBars) + "+ bars (longest " + str.tostring(len) + ")"
    else if accMode == "Whole window" and effic(aC, s0, e0) > maxER
        why := "not sideways (efficiency " + str.tostring(effic(aC, s0, e0), "#.##") + ")"
    else
        zone = hgt * touchPct / 100
        int tH = 0
        int tL = 0
        bool inH = false
        bool inL = false
        for i = s0 to e0
            nowH = array.get(aH, i) >= hi - zone
            nowL = array.get(aL, i) <= lo + zone
            if nowH and not inH
                tH += 1
            if nowL and not inL
                tL += 1
            inH := nowH
            inL := nowL
        if tH < minTouches or tL < minTouches
            why := "edges tested " + str.tostring(tH) + "x high / " + str.tostring(tL) + "x low"
    b0 = array.get(aB, s0)
    bEnd = array.get(aB, e0)
    if why != ""
        box.new(b0, hi, bEnd, lo, border_color = color.new(color.gray, 50), border_style = line.style_dashed,
             bgcolor = color.new(color.gray, 96), text = "no accumulation: " + why, text_color = color.gray,
             text_size = size.small, text_halign = text.align_left, text_valign = text.align_top)
        stTxt := "no accumulation (" + why + ")"
    else
        rngH := hi
        rngL := lo
        accBar0 := b0
        // ---- 3. volume profile of the fitted range
        float step = hgt / rows
        up = array.new<float>(rows, 0.0)
        dn = array.new<float>(rows, 0.0)
        for i = s0 to e0
            bh = array.get(aH, i)
            bl = array.get(aL, i)
            bv = array.get(aV, i)
            r0 = math.max(0, math.min(rows - 1, int(math.floor((bl - lo) / step))))
            r1 = math.max(0, math.min(rows - 1, int(math.floor((bh - lo) / step))))
            share = bv / (r1 - r0 + 1)
            for r = r0 to r1
                if array.get(aUp, i)
                    array.set(up, r, array.get(up, r) + share)
                else
                    array.set(dn, r, array.get(dn, r) + share)
        tot = array.new<float>(rows, 0.0)
        for r = 0 to rows - 1
            array.set(tot, r, array.get(up, r) + array.get(dn, r))
        pr = array.indexof(tot, array.max(tot))
        poc := lo + (pr + 0.5) * step
        target = array.sum(tot) * vaPct / 100
        int vlo = pr
        int vhi = pr
        float acc = array.get(tot, pr)
        while acc < target and (vlo > 0 or vhi < rows - 1)
            nxtUp = vhi < rows - 1 ? array.get(tot, vhi + 1) : -1.0
            nxtDn = vlo > 0 ? array.get(tot, vlo - 1) : -1.0
            if nxtUp >= nxtDn
                vhi += 1
                acc += nxtUp
            else
                vlo -= 1
                acc += nxtDn
        vah := lo + (vhi + 1) * step
        val := lo + vlo * step
        // ---- draw
        if showVP
            while array.size(vpBoxes) > rows * 6
                box.delete(array.shift(vpBoxes))
            mx = array.max(tot)
            for r = 0 to rows - 1
                wTot = int(math.round(vpWidth * array.get(tot, r) / mx))
                wUp = int(math.round(vpWidth * array.get(up, r) / mx))
                y1 = lo + r * step
                y2 = y1 + step
                if wUp > 0
                    array.push(vpBoxes, box.new(b0, y2, b0 + wUp, y1, border_color = na, bgcolor = colUp))
                if wTot - wUp > 0
                    array.push(vpBoxes, box.new(b0 + wUp, y2, b0 + wTot, y1, border_color = na, bgcolor = colDn))
        box.new(b0, hi, bEnd, lo, border_color = color.new(color.gray, 40), bgcolor = color.new(color.gray, 92),
             text = "A", text_color = color.gray, text_size = size.normal, text_halign = text.align_right, text_valign = text.align_top)
        if showLevels
            lPOC := line.new(b0, poc, bar_index, poc, color = color.red, width = 2, extend = extend.right)
            lVAH := line.new(b0, vah, bar_index, vah, color = color.new(color.white, 20), extend = extend.right)
            lVAL := line.new(b0, val, bar_index, val, color = color.new(color.white, 20), extend = extend.right)
        st := 1
        dir := 0
        failCnt := 0
        sweepExt := na
        stTxt := "accumulation found: watching for a sweep"

// ---------------------------------------------------------------- liquidity (untaken swings)
var array<float> bslP = array.new<float>()
var array<line>  bslL = array.new<line>()
var array<float> sslP = array.new<float>()
var array<line>  sslL = array.new<line>()
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
if not na(ph)
    array.push(bslP, ph)
    array.push(bslL, showLiq ? line.new(bar_index - pivLen, ph, bar_index, ph, color = colBSL, style = line.style_dashed, extend = extend.right) : na)
    if array.size(bslP) > maxLiq
        array.shift(bslP)
        line.delete(array.shift(bslL))
if not na(pl)
    array.push(sslP, pl)
    array.push(sslL, showLiq ? line.new(bar_index - pivLen, pl, bar_index, pl, color = colSSL, style = line.style_dashed, extend = extend.right) : na)
    if array.size(sslP) > maxLiq
        array.shift(sslP)
        line.delete(array.shift(sslL))
if array.size(bslP) > 0
    for i = array.size(bslP) - 1 to 0
        if high > array.get(bslP, i)
            ln = array.get(bslL, i)
            if not na(ln)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                line.set_style(ln, line.style_dotted)
            array.remove(bslP, i)
            array.remove(bslL, i)
if array.size(sslP) > 0
    for i = array.size(sslP) - 1 to 0
        if low < array.get(sslP, i)
            ln = array.get(sslL, i)
            if not na(ln)
                line.set_extend(ln, extend.none)
                line.set_x2(ln, bar_index)
                line.set_style(ln, line.style_dotted)
            array.remove(sslP, i)
            array.remove(sslL, i)

nextLiq(float from, int d, float minDist) =>
    float best = na
    cands = array.new<float>()
    src = d == 1 ? bslP : sslP
    if array.size(src) > 0
        for i = 0 to array.size(src) - 1
            array.push(cands, array.get(src, i))
    array.push(cands, d == 1 ? rngH : rngL)
    array.push(cands, d == 1 ? pdh : pdl)
    for i = 0 to array.size(cands) - 1
        p = array.get(cands, i)
        if not na(p) and (p - from) * d >= minDist
            if na(best) or (p - from) * d < (best - from) * d
                best := p
    best

amdLbl(string txt, color col, bool atHigh) =>
    label.new(bar_index, atHigh ? high : low, txt, style = atHigh ? label.style_label_down : label.style_label_up,
         color = col, textcolor = color.white, size = size.small)

// ---------------------------------------------------------------- AMD state machine
sigEntry   = false
sigFail    = false
sigInvalid = false
sigManip   = false
sigPOC     = false
float eStop = na
float eT1   = na
float eT2   = na
int   eQty  = 0

if barstate.isconfirmed and not na(poc) and inTrade and not inAcc
    if st == 1
        if low <= rngL - sweepTicks * tick and tradeLong
            st := 2
            dir := 1
            sweepExt := low
            sweepBar := bar_index
        else if high >= rngH + sweepTicks * tick and tradeShort
            st := 2
            dir := -1
            sweepExt := high
            sweepBar := bar_index
    if st == 2
        sweepExt := dir == 1 ? math.min(sweepExt, low) : math.max(sweepExt, high)
        depth = dir == 1 ? rngL - sweepExt : sweepExt - rngH
        if depth > maxDepthPct / 100 * (rngH - rngL)
            st := 7
            stTxt := "breakout, not a sweep"
        else if (dir == 1 and close > rngL) or (dir == -1 and close < rngH)
            st := 3
            sigManip := true
            stTxt := "manipulation: sweep reclaimed"
            amdLbl("M", color.purple, dir == -1)
        else if bar_index - sweepBar >= reclaimBars
            st := 7
            stTxt := "no reclaim: accepted beyond range"
    else if st == 3
        if (dir == 1 and close > poc) or (dir == -1 and close < poc)
            st := 4
            pocBar := bar_index
            failCnt := 0
            sigPOC := true
            stTxt := "beyond POC: wait for retest"
            amdLbl("D", color.teal, dir == -1)
        else if (dir == 1 and close < sweepExt) or (dir == -1 and close > sweepExt)
            st := 7
            sigInvalid := true
            stTxt := "INVALID: sweep extreme broken"
    else if st == 4 and bar_index > pocBar
        touched = dir == 1 ? low <= poc + retestTicks * tick : high >= poc - retestTicks * tick
        rightSide = dir == 1 ? close > poc : close < poc
        if not rightSide
            failCnt += 1
            if failCnt >= failCloses
                st := 6
                sigFail := true
                stTxt := "POC retest FAILED"
                amdLbl("✗ POC", color.red, dir == 1)
        else
            failCnt := 0
            if touched
                entry = close
                float base = na
                if stopMode == "Retest candle"
                    base := dir == 1 ? math.min(low, poc) : math.max(high, poc)
                else if stopMode == "Higher low / range edge"
                    base := dir == 1 ? math.min(val, rngL, low) : math.max(vah, rngH, high)
                else
                    base := sweepExt
                stp = base - dir * stopTicks * tick
                if math.abs(entry - stp) < minStopATR * atr
                    stp := entry - dir * minStopATR * atr
                risk = math.abs(entry - stp)
                qty = risk > 0 ? math.min(maxQty, int(math.floor(riskUSD / (risk * syminfo.pointvalue)))) : 0
                t1 = nextLiq(entry, dir, minRR * risk)
                t2 = na(t1) ? na : nextLiq(t1, dir, tick)
                if qty < 1
                    st := 5
                    stTxt := "retest held, but stop too wide for $" + str.tostring(riskUSD) + ": skipped"
                    amdLbl("✓ skip $", color.gray, dir == -1)
                else if na(t1)
                    st := 5
                    stTxt := "retest held, but no target >= " + str.tostring(minRR) + "R: skipped"
                    amdLbl("✓ skip R", color.gray, dir == -1)
                else
                    st := 5
                    sigEntry := true
                    eStop := stp
                    eT1 := t1
                    eT2 := na(t2) ? t1 + dir * risk : t2
                    eQty := qty
                    stTxt := "POC retest CONFIRMED: entry"
                    amdLbl("✓ POC", color.green, dir == -1)
            else if bar_index - pocBar > retestBars
                st := 5
                stTxt := "no retest in time"
    if st == 6 and ((dir == 1 and close < sweepExt) or (dir == -1 and close > sweepExt))
        st := 7
        sigInvalid := true
        stTxt := "INVALID: sweep extreme broken"

// ---------------------------------------------------------------- orders
var float tStop = na
var float tT1   = na
var float tT2   = na
var float tEnt  = na
var int   tQty  = 0
var bool  t1Done = false
pos = strategy.position_size
if sigEntry and pos == 0
    tEnt := close
    tStop := eStop
    tT1 := eT1
    tT2 := eT2
    tQty := eQty
    t1Done := false
    strategy.entry(dir == 1 ? "L" : "S", dir == 1 ? strategy.long : strategy.short, qty = eQty, comment = dir == 1 ? "AMD long" : "AMD short")
if pos != 0
    id = pos > 0 ? "L" : "S"
    q1 = tQty == 1 ? 1 : int(math.round(tQty * t1Pct / 100))
    qRest = tQty - q1
    if not t1Done and q1 > 0 and math.abs(pos) < tQty
        t1Done := true
        if beAfterT1
            tStop := tEnt
    if not t1Done and q1 > 0
        strategy.exit("T1", id, qty = q1, limit = tT1, stop = tStop, comment_profit = "T1", comment_loss = "Stop")
    if qRest > 0
        strategy.exit("T2", id, qty = qRest, limit = tT2, stop = tStop, comment_profit = "T2", comment_loss = tStop == tEnt ? "BE" : "Stop")
if pos != 0 and hmNow >= flatHM and hmNow < 1800
    strategy.close_all(comment = "Flat 4:55")

// ---------------------------------------------------------------- plots
inPos = pos != 0
plot(inPos ? tStop : na, "Stop", color = color.red, style = plot.style_linebr)
plot(inPos ? tT1 : na, "T1", color = color.lime, style = plot.style_linebr)
plot(inPos ? tT2 : na, "T2", color = color.new(color.lime, 50), style = plot.style_linebr)
plot(inPos ? tEnt : na, "Entry", color = color.gray, style = plot.style_linebr)
plot(showPD ? pdh : na, "PDH", color = colBSL, style = plot.style_stepline)
plot(showPD ? pdl : na, "PDL", color = colSSL, style = plot.style_stepline)

// ---------------------------------------------------------------- dashboard
var table dash = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)
if showDash and barstate.islast
    table.cell(dash, 0, 0, "AMD", text_color = color.white)
    table.cell(dash, 1, 0, dir == 1 ? "Bullish" : dir == -1 ? "Bearish" : "—", text_color = dir == 1 ? color.lime : dir == -1 ? color.red : color.gray)
    table.cell(dash, 0, 1, "State", text_color = color.white)
    table.cell(dash, 1, 1, stTxt, text_color = color.yellow)
    table.cell(dash, 0, 2, "POC", text_color = color.white)
    table.cell(dash, 1, 2, na(poc) ? "—" : str.tostring(poc, format.mintick), text_color = color.red)
    table.cell(dash, 0, 3, "VAH / VAL", text_color = color.white)
    table.cell(dash, 1, 3, na(poc) ? "—" : str.tostring(vah, format.mintick) + " / " + str.tostring(val, format.mintick), text_color = color.white)
    table.cell(dash, 0, 4, "Range H / L", text_color = color.white)
    table.cell(dash, 1, 4, na(poc) ? "—" : str.tostring(rngH, format.mintick) + " / " + str.tostring(rngL, format.mintick), text_color = color.gray)
    table.cell(dash, 0, 5, "Sweep", text_color = color.white)
    table.cell(dash, 1, 5, na(sweepExt) ? "—" : str.tostring(sweepExt, format.mintick), text_color = color.purple)
    table.cell(dash, 0, 6, "Trade", text_color = color.white)
    table.cell(dash, 1, 6, inPos ? (str.tostring(tQty) + " @ " + str.tostring(tEnt, format.mintick) + " | stop " + str.tostring(tStop, format.mintick) + " | T1 " + str.tostring(tT1, format.mintick) + " | T2 " + str.tostring(tT2, format.mintick)) : "flat", text_color = color.white)

// ---------------------------------------------------------------- alerts (Discord-ready JSON)
j(string s) => '{"content": "AMD VP | ' + syminfo.ticker + ' | ' + s + '"}'
if sigManip
    alert(j((dir == 1 ? "Bullish" : "Bearish") + " manipulation: sweep to " + str.tostring(sweepExt, format.mintick) + " reclaimed"), alert.freq_once_per_bar_close)
if sigPOC
    alert(j("Closed beyond POC " + str.tostring(poc, format.mintick) + " - waiting for retest"), alert.freq_once_per_bar_close)
if sigEntry
    alert(j("POC retest CONFIRMED - " + (dir == 1 ? "LONG " : "SHORT ") + str.tostring(eQty) + " @ " + str.tostring(close, format.mintick) + " | stop " + str.tostring(eStop, format.mintick) + " | T1 " + str.tostring(eT1, format.mintick) + " | T2 " + str.tostring(eT2, format.mintick)), alert.freq_once_per_bar_close)
if sigFail
    alert(j("POC retest FAILED at " + str.tostring(poc, format.mintick)), alert.freq_once_per_bar_close)
if sigInvalid
    alert(j("INVALID - sweep extreme " + str.tostring(sweepExt, format.mintick) + " broken"), alert.freq_once_per_bar_close)
